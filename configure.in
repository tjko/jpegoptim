dnl jpegoptim
dnl
dnl Process this file with autoconf to produce a configure script.
AC_INIT
AC_CONFIG_SRCDIR([jpegoptim.c])
AC_CONFIG_HEADER(config.h)
AC_CONFIG_AUX_DIR(tools)


AC_CANONICAL_HOST
HOST_TYPE=$host
AC_DEFINE_UNQUOTED(HOST_TYPE,"$host")

dnl Checks for programs.
AC_PROG_CC
AC_PROG_INSTALL
AC_PROG_MAKE_SET


AC_ARG_ENABLE([static-libjpeg],
  [AS_HELP_STRING([--enable-static-libjpeg], [Link libjpeg statically instead of dynamically])],
  [static_libjpeg=yes],
  [static_libjpeg=no])


AC_ARG_WITH(libjpeg, [  --with-libjpeg=DIR	  libjpeg is installed in ],
	[if test $withval != yes; then
	   	jpeginfo_cv_libjpeg=$withval
	fi
	if test -d "${jpeginfo_cv_libjpeg}/lib"; then
		LDFLAGS="-L${jpeginfo_cv_libjpeg}/lib $LDFLAGS"
		if test -e "${jpeginfo_cv_libjpeg}/lib/libjpeg.a"; then
		  static_libjpeg_lib="${jpeginfo_cv_libjpeg}/lib/libjpeg.a"
		fi
		CPPFLAGS="$CPPFLAGS -I${jpeginfo_cv_libjpeg}/include"
	else
		LDFLAGS="-L${jpeginfo_cv_libjpeg} $LDFLAGS"
		if test -e "${jpeginfo_cv_libjpeg}/libjpeg.a"; then
		  static_libjpeg_lib="${jpeginfo_cv_libjpeg}/libjpeg.a"
		fi
		if test -e "${jpeginfo_cv_libjpeg}/.libs/libjpeg.a"; then
		  static_libjpeg_lib="${jpeginfo_cv_libjpeg}/.libs/libjpeg.a"
		fi
		CPPFLAGS="$CPPFLAGS -I${jpeginfo_cv_libjpeg}"
	fi
	if test -d "${jpeginfo_cv_libjpeg}/build"; then
		LDFLAGS="-L${jpeginfo_cv_libjpeg}/build $LDFLAGS"
		if test -e "${jpeginfo_cv_libjpeg}/build/libjpeg.a"; then
		  static_libjpeg_lib="${jpeginfo_cv_libjpeg}/build/libjpeg.a"
		fi
		CPPFLAGS="-I${jpeginfo_cv_libjpeg}/build $CPPFLAGS"
	fi
	])

arith_code=0
AC_ARG_WITH(arith, [  --with-arith		  Enable arithmetic coding support ],
	[
	if test $withval == yes; then
	   arith_code=1
	fi
	])


dnl Checks for libraries.
AS_IF([test "x$static_libjpeg" = "xyes"], [
   # Search for static library
   AC_CHECK_FILE([$static_libjpeg_lib],
     [JPEG_LIBS="$static_libjpeg_lib"],
     [AC_MSG_ERROR([Static libjpeg.a not found ($static_libjpeg_lib)])])
  ], [
   AC_CHECK_LIB(jpeg, jpeg_read_header, [JPEG_LIBS="-ljpeg"] ,[
     echo "Cannot find libjpeg or you have too old version (v6 or later required)."
     exit 1
   ])
])
LIBS="$LIBS $JPEG_LIBS"

dnl AC_CHECK_LIB(m, round)
AC_CHECK_LIB(m, floor)

dnl Checks for header files.

AC_HEADER_STDC
AC_CHECK_HEADERS(unistd.h getopt.h string.h libgen.h math.h fcntl.h sys/stat.h sys/time.h sys/wait.h)
AC_CHECK_HEADERS(jpeglib.h,,[
echo "Cannot find jpeglib.h  You need libjpeg v6 (or later)."
exit 1
])


dnl Checks for typedefs, structures, and compiler characteristics.

AC_CHECK_SIZEOF(long)
AC_CHECK_SIZEOF(int)



dnl Checks for library functions.
AC_CHECK_FUNCS(getopt_long, break, [GNUGETOPT="getopt.o getopt1.o"])
AC_SUBST(GNUGETOPT)

AC_CHECK_FUNCS(mkstemps)
AC_CHECK_FUNCS(labs)
AC_CHECK_FUNCS(fileno)
AC_CHECK_FUNCS(futimens)
AC_CHECK_FUNCS(futimes)
AC_CHECK_FUNCS(fchmod)
AC_CHECK_FUNCS(fchown)
AC_CHECK_FUNCS(fork)
AC_CHECK_FUNCS(wait)

AC_CHECK_MEMBERS([struct stat.st_mtim])


dnl own tests

AC_CACHE_CHECK([for broken jmorecfg.h (METHODDEF)], [jpegoptim_cv_broken_methoddef], [
    AC_LINK_IFELSE([AC_LANG_PROGRAM([[
      #include <stdio.h>
      #include <jpeglib.h>
      METHODDEF(void) foo(void) { };
    ]], [[
	return 0;
    ]])],
    [jpegoptim_cv_broken_methoddef=no],
    [jpegoptim_cv_broken_methoddef=yes])
  ])

if test $jpegoptim_cv_broken_methoddef = yes; then
  AC_DEFINE(BROKEN_METHODDEF)
fi

AC_CACHE_CHECK([Arithmetic Coding support in JPEG library], [jpegoptim_cv_arith_code_support], [
    AC_LINK_IFELSE([AC_LANG_PROGRAM([[
      #include <stdio.h>
      #include <jpeglib.h>
    ]], [[
	struct jpeg_compress_struct cinfo;
	cinfo.arith_code=TRUE;
	return 0;
    ]])],
    [jpegoptim_cv_arith_code_support=yes],
    [jpegoptim_cv_arith_code_support=no])
  ])

if test $arith_code == 1 -a $jpegoptim_cv_arith_code_support = yes; then
  arith_code_status="Enabled"
  AC_DEFINE(HAVE_ARITH_CODE)
else
  arith_code_status="Disabled"
fi


AC_CACHE_CHECK([Extension settings in JPEG library], [jpegoptim_cv_extension_settings], [
    AC_LINK_IFELSE([AC_LANG_PROGRAM([[
      #include <stdio.h>
      #include <jpeglib.h>
    ]], [[
      struct jpeg_compress_struct cinfo;
      jpeg_c_set_int_param(&cinfo, JINT_DC_SCAN_OPT_MODE, 1);
    ]])],
    [jpegoptim_cv_extension_settings=yes],
    [jpegoptim_cv_extension_settings=no])
  ])

if test $jpegoptim_cv_extension_settings = yes; then
  extension_settings_status="Present"
  AC_DEFINE(HAVE_JINT_DC_SCAN_OPT_MODE)
else
  extension_settings_status="Absent"
fi

AC_CACHE_CHECK([whether libjpeg is MozJPEG], [ax_cv_have_mozjpeg], [
    AC_LINK_IFELSE([AC_LANG_PROGRAM([[
      #include <stdio.h>
      #include <jpeglib.h>
    ]], [[
      struct jpeg_compress_struct cinfo;
      jpeg_c_set_int_param(&cinfo, JINT_COMPRESS_PROFILE, JCP_MAX_COMPRESSION);
    ]])],
    [ax_cv_have_mozjpeg=yes],
    [ax_cv_have_mozjpeg=no])
  ])

if test $ax_cv_have_mozjpeg = yes; then
  AC_DEFINE(HAVE_MOZJPEG)
fi


echo "--------------------------------------------------"
echo "Extension settings: $extension_settings_status"
echo "Arithmetic coding: $arith_code_status"
if test $arith_code == 0 -a "$jpegoptim_cv_arith_code_support" == "yes"; then
   echo "(use --with-arith to enable Arithmetic coding support)"
fi
echo "--------------------------------------------------"


AC_CONFIG_FILES([Makefile])
AC_OUTPUT
